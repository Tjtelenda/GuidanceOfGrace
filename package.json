{
  "name": "guidance-of-grace",
  "productName": "Guidance of Grace",
  "version": "0.5.1",
  "description": "Offline spoiler-light Elden Ring and Seamless Co-op companion with read-only save tracking and an optional in-game overlay.",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "test:desktop": "node tests/test-desktop-core.mjs",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@zebbedaja/er-save-parser": "0.1.13",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.guidanceofgrace.app",
    "productName": "Guidance of Grace",
    "asar": true,
    "files": [
      "app.js",
      "cloud.js",
      "cloud-config.js",
      "data.js",
      "index.html",
      "manifest.webmanifest",
      "save-parser.js",
      "service-worker.js",
      "styles.css",
      "content/**/*",
      "desktop/**/*",
      "README.md",
      "LOCAL_KNOWLEDGE.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "Guidance of Grace contributors"
}
