{
  "name": "guidance-of-grace",
  "productName": "Guidance of Grace",
  "version": "0.6.1",
  "description": "Offline second-screen Elden Ring companion with read-only local save tracking.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "test:desktop": "node tests/test-desktop-core.mjs",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@zebbedaja/er-save-parser": "0.1.13",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.guidanceofgrace.app",
    "productName": "Guidance of Grace",
    "asar": true,
    "files": [
      "app.js",
      "data.js",
      "index.html",
      "manifest.webmanifest",
      "save-parser.js",
      "service-worker.js",
      "styles.css",
      "content/**/*",
      "desktop/**/*",
      "README.md",
      "LOCAL_KNOWLEDGE.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "desktop-layout.css",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Tjtelenda",
        "repo": "GuidanceOfGrace"
      }
    ],
    "artifactName": "Guidance-of-Grace-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE.project.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/@zebbedaja/er-save-parser/LICENSE",
        "to": "licenses/LICENSE.er-save-parser.txt"
      },
      {
        "from": "content/licenses/ER_Boss_Kill_Checklist.txt",
        "to": "licenses/LICENSE.encounter-catalog.txt"
      }
    ]
  },
  "author": "Trent Telenda",
  "license": "MIT"
}
